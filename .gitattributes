# Consistent source-code checkouts across Windows and Unix.
* text=auto eol=lf
*.ps1 text eol=crlf

# Integrity manifests depend on the exact original and passage-store bytes.
*.html -text
artifacts/index/chunks.jsonl -text

# Binary deliverables and generated evidence.
*.pdf binary
*.pptx binary
*.png binary
*.npy binary
*.zip binary
*.mp4 binary
*.webm binary
*.jpg binary

# Approval hashes bind the exact preserved final bytes, including sidecars.
demo/final/** -text -whitespace

# The submission ZIP carries this exact generated text file too.
submission/README.txt -text -whitespace
